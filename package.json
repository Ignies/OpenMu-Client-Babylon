{
  "name": "OpenMuJSClient",
  "module": "src/server/main.ts",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=dev vite --force",
    "build": "APP_ENV=prod vite build && bun run copy-data && bun run compress-assets && bun run lite-assets && bun run assets-index && bun run asset-bundles",
    "copy-data": "bun run tools/copyData.ts && bun run tools/copyData.ts --src Data-v097d --out dist/Data-v097d",
    "compress-assets": "bun run tools/compressAssets.ts",
    "lite-assets": "bun run tools/liteAssets.ts",
    "assets-index": "bun run tools/assetsIndex.ts",
    "asset-bundles": "bun run tools/assetBundles.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "proxy": "bun run --watch proxy/main.ts",
    "dev:register": "vite --config register/vite.config.ts",
    "build:register": "APP_ENV=prod vite build --config register/vite.config.ts",
    "register-api": "bun run --watch register/server/main.ts",
    "cashshop-gate": "bun run cashshop/server/gateCli.ts",
    "ops": "bun run ops/server/opsCli.ts",
    "ops-ingest": "bun run ops/server/opsCli.ts ingest",
    "ops-follow": "bun run ops/server/opsCli.ts follow",
    "cashshop-orders": "bun run cashshop/server/ordersCli.ts",
    "generate": "bun run versions/shared/packets/generate.ts",
    "test": "vitest run",
    "tsc": "tsc --noEmit",
    "lint": "eslint . --max-warnings=100000",
    "lint:count": "eslint . -f json | bun run tools/lintCounts.ts",
    "cashshop-api": "bun run --watch cashshop/server/main.ts",
    "cashshop-serve": "bun run cashshop/server/main.ts",
    "marketplace-api": "bun run --watch marketplace/server/main.ts",
    "marketplace-serve": "bun run marketplace/server/main.ts",
    "marketplace-audit": "bun run marketplace/server/boxAuditCli.ts",
    "test:server": "bun test ./marketplace/server/",
    "check": "bun tools/checks/index.ts",
    "check:lint": "eslint . -f json | bun tools/checks/lintRatchet.ts",
    "check:commits": "bun tools/checks/commits.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4",
    "@gltf-transform/functions": "4",
    "@lunapaint/tga-codec": "0.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bun-types": "1.4.4",
    "eslint": "10",
    "eslint-plugin-mobx": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "less": "4.9.1",
    "meshoptimizer": "^1.3.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "@babylonjs/loaders": "9.32.0",
    "@babylonjs/materials": "9.32.0",
    "bcryptjs": "^3.0.3",
    "miniplex": "2.0.0",
    "mitt": "3.0.1",
    "mobx": "7.1.1",
    "mobx-react-lite": "5.1.0",
    "nanoid": "6.0.2",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": "20"
  }
}
