node_modules/
dist
dist-register

# Build-time endpoints and the OpenMU admin credentials. `.env.example` files
# are committed in their place. Note `dist` above does not cover
# `dist-register`: gitignore matches whole path segments, not prefixes.
.env

# gzip sidecars (tools/compressAssets.ts). Generated into dist/ by the build;
# a dev server can be given its own set under public/, which is not committed -
# they are derived from files that are.
public/**/*.gz
Data/**/*.gz
Data-v097d/**/*.gz

# Texture packs: images built out of tree by the upscale pipeline and shipped
# beside the app, the way the gzip sidecars above are. Hundreds of megabytes
# that regenerate from the source art, so they are deployed rather than
# committed; VITE_TEXTURE_PACKS_URL points the client at wherever they land.
public/packs/
public/packs-v097d/
